# Copy thành server/.env rồi điền giá trị.

# OAuth Client ID loại "Web application" tạo ở Google Cloud Console.
GOOGLE_CLIENT_ID=

# Tài khoản root (cách nhau bởi dấu phẩy): không thuộc công ty, chỉ vào màn "Cấu hình hệ thống" để gán vai trò
# (kể cả Director), duyệt / khoá tài khoản, xếp team. Dùng email riêng, không phải email nhân viên: email của một
# tài khoản có sẵn sẽ bị chuyển thành root và rời mọi team. Xoá email khỏi đây là thu hồi quyền root ngay.
ROOT_EMAILS=

# Các email này luôn đăng nhập với vai trò Director: toàn quyền, quản lý các Manager (cách nhau bởi dấu phẩy).
DIRECTOR_EMAILS=

# Các email này luôn đăng nhập với vai trò Manager, trừ người đã là Director (cách nhau bởi dấu phẩy).
MANAGER_EMAILS=

# Chuỗi ngẫu nhiên dài, bắt buộc khi deploy.
JWT_SECRET=

# Đăng nhập bằng email bất kỳ không cần Google. CHỈ dùng khi dev local.
# DEV_LOGIN=1
