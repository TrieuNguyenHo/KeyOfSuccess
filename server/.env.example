# Copy thành server/.env rồi điền giá trị.

# OAuth Client ID loại "Web application" tạo ở Google Cloud Console.
GOOGLE_CLIENT_ID=

# Các email này luôn đăng nhập với vai trò Manager (cách nhau bởi dấu phẩy).
MANAGER_EMAILS=

# Chuỗi ngẫu nhiên dài, bắt buộc khi deploy.
JWT_SECRET=

# Đăng nhập bằng email bất kỳ không cần Google. CHỈ dùng khi dev local.
# DEV_LOGIN=1
